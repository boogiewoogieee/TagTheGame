:root {
}

.header {
    font-size: 90px;
    align-self: center;
    margin-top: 201px;
}

.button {
    width: 300px;
    height: 100px;
    align-self: center;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(5, 58, 5);
    border-right-color: rgb(5, 58, 5);
    border-top-color: rgb(5, 58, 5);
    border-bottom-color: rgb(5, 58, 5);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    font-size: 30px;
    background-color: rgb(145, 183, 120);
    margin-top: 55px;
    position: relative;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
