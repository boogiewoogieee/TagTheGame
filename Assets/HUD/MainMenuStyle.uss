    background-color: rgb(209, 191, 50); /* ¯ó³ty akcent z hovera przycisków */
}
/* --- POPRAWNY I CZYSTY STYL DLA DROPDOWNA --- */

.unity-base-popup-field {
    margin-bottom: 15px;
}

.unity-base-popup-field__label {
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
}

/* W³aœciwe pole wyboru (pude³ko) */
.unity-base-popup-field__input {
    background-color: rgb(230, 240, 225); 
    border-color: rgb(5, 58, 5);          
    border-width: 2px;
    border-radius: 6px;
    padding: 6px 10px;
}

.unity-base-popup-field__text {
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
}

.unity-base-popup-field__input:hover {
    background-color: rgb(209, 191, 50);  
}
/* --- WYŒRODKOWANIE I STYLIZACJA TOGGLE (HOST SERVER) --- */

.unity-toggle {
    align-self: center; /* Wyœrodkowuje ca³y element poziomo w oknie */
    margin-bottom: 15px;
    width: 80%;         /* Dopasuj szerokoœæ, jeœli potrzebujesz */
}

/* Etykieta prze³¹cznika */
.unity-toggle__label {
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
}

/* W³aœciwy kwadracik (checkbox) */
.unity-toggle__input {
    flex-direction: row-reverse; /* Opcjonalnie: odwraca kolejnoœæ, ¿eby kwadracik by³ z innej strony ni¿ tekst, jeœli wolisz */
    justify-content: flex-start;
}

.unity-toggle__checkmark {
    background-color: rgb(230, 240, 225);
    border-color: rgb(5, 58, 5);
    border-width: 2px;
    border-radius: 4px;
    width: 20px;
    height: 20px;
}

.unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: rgb(145, 183, 120); 
    border-color: rgb(5, 58, 5);
}
/* --- BEZPIECZNE NAPRAWIENIE ETYKIET W SETTINGS I MULTIPLAYER --- */

/* Przywracamy domyœlny, poprawny uk³ad etykiet, ¿eby "Low" i "High" nie nachodzi³y na siebie */
.unity-base-field__label {
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    min-width: 110px; /* Zapewnia odpowiedni¹ przestrzeñ na tekst */
}

/* Styl suwaków */
.unity-base-slider__tracker {
    background-color: rgb(5, 58, 5); 
    border-radius: 4px;
    height: 6px;
}

.unity-base-slider__dragger {
    background-color: rgb(145, 183, 120); 
    border-color: rgb(5, 58, 5);     
    border-width: 2px;
    border-radius: 6px;
    min-width: 16px;
    min-height: 22px;
}

.unity-base-slider__dragger:hover {
    background-color: rgb(209, 191, 50); 
}