    min-width: 120px;
}

/* W³aœciwy przycisk z wybran¹ opcj¹ (np. "Anyone") – tu wraca t³o! */
.unity-base-popup-field__input {
    background-color: rgb(230, 240, 225); /* Jasne t³o, takie jak w polu tekstowym */
    border-color: rgb(5, 58, 5);          /* Ciemna ramka w stylu przycisków */
