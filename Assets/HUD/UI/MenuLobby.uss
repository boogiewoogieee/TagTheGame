/* Additions to RoniToni's menu for networking: the name and address fields on the
   Joining screen and the player slots and buttons on the Lobby screen. Colours come
   from MainMenuStyle.uss so the additions match her screens. */

.join-fields {
    flex-direction: row;
    margin-top: 70px;
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 5px;
}

.join-field {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 30px;
    -unity-font-style: bold;
}

.lobby-slots {
    flex-direction: row;
    justify-content: space-between;
    width: 1300px;
    align-self: center;
}

/* One card per player: portrait with arrows, name, character, ready state. */
.lobby-slot {
    width: 620px;
    height: 400px;
    align-items: center;
    padding-top: 15px;
    padding-bottom: 10px;
    background-color: rgb(230, 240, 225);
    border-width: 2px;
    border-color: rgb(5, 58, 5);
    border-radius: 10px;
}

.lobby-pick {
    flex-direction: row;
    align-items: center;
}

.lobby-portrait {
    width: 240px;
    height: 240px;
    margin-left: 25px;
    margin-right: 25px;
    background-color: rgb(107, 179, 74);
    border-width: 4px;
    border-color: rgb(5, 58, 5);
    border-radius: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

/* The theme has no default Button look, so the arrows are styled in full. */
.lobby-arrow {
    width: 76px;
    height: 76px;
    margin: 0;
    padding: 0;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(30, 26, 22);
    background-color: rgb(245, 154, 35);
    border-width: 4px;
    border-color: rgb(30, 26, 22);
    border-radius: 38px;
}

.lobby-arrow:hover {
    background-color: rgb(209, 191, 50);
}

.lobby-arrow:disabled {
    opacity: 0.35;
}

.lobby-slot-name {
    margin-top: 12px;
    font-size: 34px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
}

.lobby-slot-character {
    font-size: 24px;
    color: rgb(43, 45, 53);
    -unity-font-style: bold;
}

.lobby-slot-state {
    font-size: 26px;
    -unity-font-style: bold;
}

.lobby-slot--empty .lobby-slot-name {
    color: rgb(110, 135, 110);
    -unity-font-style: italic;
}

.lobby-slot--empty .lobby-portrait {
    background-color: rgb(190, 200, 185);
    border-color: rgb(110, 135, 110);
}

/* The 10 characters: your pick framed orange, the other player's pick greyed out. */
.lobby-roster {
    flex-direction: row;
    justify-content: center;
    margin-top: 15px;
    margin-bottom: 5px;
}

.lobby-roster-cell {
    width: 100px;
    height: 100px;
    margin: 0 6px;
    padding: 0;
    background-color: rgb(246, 231, 193);
    border-width: 4px;
    border-color: rgb(30, 26, 22);
    border-radius: 16px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-text-align: lower-right;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(30, 26, 22);
}

.lobby-roster-cell:hover {
    scale: 1.08 1.08;
}

.lobby-roster-cell--mine {
    border-width: 7px;
    border-color: rgb(245, 154, 35);
    background-color: rgb(107, 179, 74);
}

.lobby-roster-cell--taken {
    background-color: rgb(122, 124, 132);
    -unity-background-image-tint-color: rgb(150, 150, 150);
}

.lobby-roster-cell:disabled {
    opacity: 0.55;
}

.lobby-roster-cell--mine:disabled {
    opacity: 1;
}

.lobby-state--ready {
    color: rgb(20, 120, 40);
}

.lobby-state--not-ready {
    color: rgb(170, 60, 20);
}

.lobby-status {
    align-self: center;
    margin-top: 5px;
    margin-bottom: 15px;
    margin-left: 20px;
    margin-right: 20px;
    font-size: 24px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: upper-center;
}

.lobby-buttons {
    flex-direction: row;
    justify-content: center;
}

.button.lobby-button {
    width: 300px;
    height: 90px;
    margin-top: 0;
    margin-left: 15px;
    margin-right: 15px;
    font-size: 34px;
}

.button.lobby-leave {
    width: 260px;
    height: 60px;
    margin-top: 15px;
    font-size: 28px;
}

/* Start match stays visible for the host but faded until both players are ready. */
.button.lobby-button:disabled {
    opacity: 0.45;
}

/* The list of open online games on the Joining screen (feature 4). */

.game-list-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 760px;
    align-self: center;
    margin-top: 15px;
    margin-bottom: 5px;
}

.game-list-title {
    font-size: 30px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
}

.button.game-list-refresh {
    width: 160px;
    height: 50px;
    font-size: 24px;
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
}

.game-list {
    width: 760px;
    height: 170px;
    align-self: center;
    background-color: rgb(230, 240, 225);
    border-width: 2px;
    border-color: rgb(5, 58, 5);
    border-radius: 10px;
}

.game-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 60px;
    padding-left: 20px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-color: rgb(150, 180, 150);
}

.game-row-name {
    font-size: 28px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    flex-shrink: 1;
    overflow: hidden;
}

.button.game-row-join {
    width: 120px;
    height: 46px;
    font-size: 24px;
    align-self: center;
    margin: 0;
}

.game-list-status {
    align-self: center;
    margin-top: 5px;
    margin-left: 20px;
    margin-right: 20px;
    font-size: 22px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: upper-center;
}

/* The menu's theme has no Unity default styles, so the list's inner parts get no size of
   their own: without these the rows spill out of a zero-height viewport. The scrollbars
   stay hidden (the mouse wheel still scrolls), since the theme would draw them with the
   settings sliders' look. */
.game-list .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.game-list .unity-scroll-view__content-viewport {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.game-list .unity-scroll-view__content-container {
    flex-shrink: 0;
}
