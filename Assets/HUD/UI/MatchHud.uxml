<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../MainMenuStyle.uss" />
    <Style src="MatchHud.uss" />
    <ui:VisualElement name="MatchHud" picking-mode="Ignore" class="hud-root">
        <ui:Label name="Timer" text="30" picking-mode="Ignore" class="hud-timer" />
        <ui:Label name="Status" text="Opponent has the bomb" picking-mode="Ignore" class="hud-status" />
        <ui:VisualElement name="RoundOver" picking-mode="Ignore" class="hud-overlay hud-round-over">
            <ui:Label name="Result" text="You win" picking-mode="Ignore" class="hud-result" />
            <ui:Button name="Leave" text="Leave to menu" focusable="false" class="button hud-button" />
        </ui:VisualElement>
        <ui:VisualElement name="Menu" class="hud-overlay hud-menu-backdrop">
            <ui:VisualElement name="MenuCard" class="hud-menu-card">
                <ui:Label text="Menu" picking-mode="Ignore" class="hud-menu-title" />
                <ui:Label text="The round keeps running while this is open." picking-mode="Ignore" class="hud-menu-hint" />
                <ui:Button name="Resume" text="Resume" focusable="false" class="button hud-button" />
                <ui:Button name="MenuLeave" text="Leave to menu" focusable="false" class="button hud-button" />
                <ui:Button name="Quit" text="Quit game" focusable="false" class="button hud-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
