.hud-root {
    flex-grow: 1;
    align-items: center;
}

.hud-timer {
    margin-top: 30px;
    font-size: 96px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-status {
    margin-top: 10px;
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-status-danger {
    color: rgb(255, 96, 64);
}

.hud-result {
    font-size: 140px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-result-win {
    color: rgb(125, 220, 110);
}

.hud-result-lose {
    color: rgb(255, 96, 64);
}

.hud-score {
    margin-top: -10px;
    font-size: 72px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-countdown {
    margin-top: 10px;
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

/* Full-screen layers on top of the HUD; each one centres its content horizontally. */
.hud-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

/* Result and its buttons sit in the upper part of the screen, leaving the players visible. */
.hud-round-over {
    justify-content: flex-start;
    padding-top: 110px;
}

/* Same look as the main menu's buttons (.button in MainMenuStyle.uss), sized for the HUD. */
.button.hud-button {
    width: 420px;
    height: 90px;
    margin-top: 30px;
    font-size: 36px;
}

.hud-menu-backdrop {
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.7);
}

/* The main menu's green panel, so the in-game menu reads as part of the same game. */
.hud-menu-card {
    width: 620px;
    padding-top: 40px;
    padding-bottom: 50px;
    padding-left: 40px;
    padding-right: 40px;
    align-items: center;
    background-color: rgb(131, 202, 149);
    border-width: 4px;
    border-color: rgb(5, 58, 5);
    border-radius: 20px;
}

.hud-menu-title {
    font-size: 64px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-menu-hint {
    margin-top: 6px;
    margin-bottom: 10px;
    font-size: 24px;
    color: rgb(5, 58, 5);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Results screen: the menu card, wider, with a small stats table. */
.results-card {
    width: 820px;
    padding-top: 30px;
    padding-bottom: 36px;
}

.results-score {
    margin-top: -6px;
    margin-bottom: 18px;
    font-size: 56px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.results-row {
    flex-direction: row;
    width: 100%;
    height: 52px;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 8px;
    background-color: rgb(230, 240, 225);
    border-width: 2px;
    border-color: rgb(5, 58, 5);
    border-radius: 10px;
}

.results-row--header {
    height: 40px;
    background-color: rgba(5, 58, 5, 0.15);
}

.results-cell {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 26px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.results-cell--name {
    flex-grow: 2;
    -unity-text-align: middle-left;
}

.results-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.button.results-button {
    width: 300px;
    height: 80px;
    margin-top: 0;
    margin-left: 10px;
    margin-right: 10px;
    font-size: 30px;
}

.button.results-leave {
    width: 240px;
    height: 60px;
    margin-top: 18px;
    font-size: 26px;
}

.button.hud-button:disabled {
    opacity: 0.45;
}
