.hud-root {
    flex-grow: 1;
    align-items: center;
}

.hud-timer {
    margin-top: 30px;
    font-size: 96px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    transition-property: scale, color;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out, ease-out;
}

/* The last seconds of the fuse: red, and each new second pops in big and settles. */
.hud-timer--danger {
    color: rgb(255, 64, 40);
}

.hud-timer--pop {
    scale: 1.4 1.4;
    transition-duration: 0s, 0s;
}

/* Red screen edges for the holder; FuseDangerHud sets the picture and the opacity. */
.hud-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Fuse Rush: speed lines over the whole screen while it runs (FuseRushHud draws them). */
.hud-rush-lines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
}

/* Fuse Rush skill icon, bottom right; only the holder sees it. */
.hud-rush {
    position: absolute;
    right: 48px;
    bottom: 48px;
    align-items: center;
    display: none;
    opacity: 0.75;
    transition-property: scale, opacity;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out-back, ease-out;
}

.hud-rush--ready,
.hud-rush--active {
    opacity: 1;
}

.hud-rush--pop {
    scale: 1.25 1.25;
    transition-duration: 0s, 0s;
}

.hud-rush-ring {
    width: 104px;
    height: 104px;
    border-radius: 52px;
    background-color: rgba(30, 26, 22, 0.55);
    align-items: center;
    justify-content: center;
}

.hud-rush-key {
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-rush-name {
    margin-top: 6px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-rush--active .hud-rush-name {
    color: rgb(255, 217, 77);
}

.hud-status {
    margin-top: 10px;
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    transition-property: scale;
    transition-duration: 0.2s;
}

.hud-status--pop {
    scale: 1.3 1.3;
    transition-duration: 0s;
}

/* A warm flash over the screen when the local player is tagged; MatchHud switches it on for a moment. */
.hud-pass-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(255, 170, 60);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.hud-pass-flash--on {
    opacity: 0.35;
    transition-duration: 0s;
}

.hud-status-danger {
    color: rgb(255, 96, 64);
}

.hud-result {
    font-size: 140px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-result-win {
    color: rgb(125, 220, 110);
}

.hud-result-lose {
    color: rgb(255, 96, 64);
}

.hud-score {
    margin-top: -10px;
    font-size: 72px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-countdown {
    margin-top: 10px;
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

/* Full-screen layers on top of the HUD; each one centres its content horizontally. */
.hud-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

/* Result and its buttons sit in the upper part of the screen, leaving the players visible. */
.hud-round-over {
    justify-content: flex-start;
    padding-top: 110px;
}

/* Round start: the digit in the upper half of the screen, the round and the bomb note under it. */
.hud-round-start {
    /* Hidden until RoundCountdown shows it, so the layout never shows its placeholder digit. */
    display: none;
    justify-content: flex-start;
    padding-top: 150px;
}

.hud-start-digit {
    height: 240px;
    font-size: 220px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-start-round {
    margin-top: 10px;
    font-size: 52px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-start-bomb {
    margin-top: 4px;
    font-size: 40px;
    color: rgb(125, 220, 110);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-start-bomb--danger {
    color: rgb(255, 96, 64);
}

/* Same look as the main menu's buttons (.button in MainMenuStyle.uss), sized for the HUD. */
.button.hud-button {
    width: 420px;
    height: 90px;
    margin-top: 30px;
    font-size: 36px;
}

.hud-menu-backdrop {
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.7);
}

/* The main menu's green panel, so the in-game menu reads as part of the same game. */
.hud-menu-card {
    width: 620px;
    padding-top: 40px;
    padding-bottom: 50px;
    padding-left: 40px;
    padding-right: 40px;
    align-items: center;
    background-color: rgb(131, 202, 149);
    border-width: 4px;
    border-color: rgb(5, 58, 5);
    border-radius: 20px;
}

.hud-menu-title {
    font-size: 64px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-menu-hint {
    margin-top: 6px;
    margin-bottom: 10px;
    font-size: 24px;
    color: rgb(5, 58, 5);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Results screen: the menu card, wider, with a small stats table. */
.results-card {
    width: 820px;
    padding-top: 30px;
    padding-bottom: 36px;
}

.results-score {
    margin-top: -6px;
    margin-bottom: 18px;
    font-size: 56px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.results-row {
    flex-direction: row;
    width: 100%;
    height: 52px;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 8px;
    background-color: rgb(230, 240, 225);
    border-width: 2px;
    border-color: rgb(5, 58, 5);
    border-radius: 10px;
}

.results-row--header {
    height: 40px;
    background-color: rgba(5, 58, 5, 0.15);
}

.results-cell {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 26px;
    color: rgb(5, 58, 5);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.results-cell--name {
    flex-grow: 2;
    -unity-text-align: middle-left;
}

.results-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.button.results-button {
    width: 300px;
    height: 80px;
    margin-top: 0;
    margin-left: 10px;
    margin-right: 10px;
    font-size: 30px;
}

.button.results-leave {
    width: 240px;
    height: 60px;
    margin-top: 18px;
    font-size: 26px;
}

.button.hud-button:disabled {
    opacity: 0.45;
}
